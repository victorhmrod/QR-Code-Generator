{
  "name": "qr-code-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app for generating custom QR codes.",
  "author": "Victor H",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && electron-builder",
    "build:dir": "tsc -b --noEmit && vite build && electron-builder --dir",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.victorh.qrcodegenerator",
    "productName": "QR Code Generator",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
